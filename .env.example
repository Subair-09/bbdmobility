# BBD Mobility Configuration
PORT=3001

# Resend API Key for sending booking notifications and newsletter emails
# Get your API key at https://resend.com
RESEND_API_KEY=

# Business Dispatch notification recipient email
BUSINESS_EMAIL=support@bbdmobility.com

# Verified Sender Email (must be configured in Resend domains)
# Default sandbox sender: onboarding@resend.dev
FROM_EMAIL="BBD Mobility <onboarding@resend.dev>"
