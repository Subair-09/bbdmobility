# BBD Mobility Configuration
PORT=3001

# Production App URL (e.g. your Vercel deployment URL or custom domain)
APP_URL=https://your-domain.vercel.app

# MongoDB Connection String (Atlas Cluster)
MONGODB_URI=mongodb+srv://<username>:<encoded_password>@cluster0.tzicd9s.mongodb.net/bbdmobility?retryWrites=true&w=majority

# Security Secrets
JWT_SECRET=your_jwt_secret_key_here
OTP_SECRET=your_hmac_sha256_otp_secret_here

# Resend API Key for sending booking notifications, rider alerts, and OTP emails
# Get your API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Business Dispatch notification recipient emails (comma-separated)
BUSINESS_EMAILS="Sales@bbdautosng.com,Info@bbdautosng.com"

# Verified Sender Email (configured under your verified domain bbdmobility.com.ng)
FROM_EMAIL="BBD Mobility <booking@bbdmobility.com.ng>"

# Cloudinary Storage Configuration (for Proof of Pickup & Proof of Delivery Photos)
# Obtain from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# KudiSMS Configuration (for Nigerian Mobile SMS Notifications to Senders, Receivers & Riders)
# Register and obtain your API Token & approved Sender ID at https://kudisms.net
KUDISMS_API_KEY=your_kudisms_api_key_here
KUDISMS_SENDER_ID=BBDMobility
KUDISMS_GATEWAY=2
